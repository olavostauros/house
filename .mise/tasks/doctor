#!/usr/bin/env bash
#MISE description="Check a house against the framework's invariants"
#USAGE flag "--house <path>" help="The house directory; defaults to the current directory"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/house.sh"

HOUSE="$(house_root "${usage_house:-.}")"
WORK="$(house_work_dir "$HOUSE")"
FAILS=0

ok()   { say "ok:   $*"; }
warn() { say "warn: $*"; }
fail() { say "fail: $*"; FAILS=$((FAILS + 1)); }
note() { say "note: $*"; }

say "house: $(display_path "$HOUSE")"
say "work:  $(display_path "$WORK")"
say ""

version="$(bash_version)"
if version_at_least "$version" 4; then ok "bash $version"; else fail "bash $version: house needs bash 4 or newer first on PATH"; fi
version="$(git_version)"
if version_at_least "$version" 2.28; then ok "git $version"; else fail "git $version: house init needs git 2.28 or newer for git init -b"; fi
for key in name email; do
  if git_identity "$WORK" "$key"; then ok "git user.$key"; else fail "git user.$key is unset, so house init cannot commit → git config --global user.$key '…'"; fi
done
if command -v mise >/dev/null 2>&1; then ok "mise on PATH"; else fail "mise is not on PATH, and every house command runs through it → put the directory holding mise on PATH"; fi
if [ -n "${HOUSE_CALLER_PWD:-}" ]; then
  if command -v jq >/dev/null 2>&1; then ok "jq on PATH"; else warn "jq is not on PATH: without it the house shim runs 'house agent add' as 'mise run agent add' → install jq"; fi
fi
if on_path "$HOME/.local/bin"; then ok "$(display_path "$HOME/.local/bin") on PATH"; else warn "$(display_path "$HOME/.local/bin") is not on PATH, and shiv and mise install there → export PATH=\"\$HOME/.local/bin:\$PATH\""; fi
recorded="$(house_framework_version "$HOUSE")"
running="$(framework_version)"
if [ -z "$recorded" ]; then note "framework: the README records no framework version (this tool is $running)"
elif [ "$recorded" = "$running" ]; then ok "framework: made at $recorded, this tool's version"
else note "framework: made at $recorded; this tool is $running"
fi
say ""

for f in AGENTS.md README.md mise.toml roster.tsv notes/work-queue.md notes/household-backlog.md \
         hooks/agent-identity .mise/tasks/welcome .mise/tasks/test .mise/tasks/agent-env .mise/tasks/install-hooks; do
  if [ -f "$HOUSE/$f" ]; then ok "$f"; else fail "$f missing"; fi
done

for f in hooks/agent-identity .mise/tasks/welcome .mise/tasks/test .mise/tasks/agent-env .mise/tasks/install-hooks; do
  [ -f "$HOUSE/$f" ] && [ ! -x "$HOUSE/$f" ] && fail "$f is not executable"
done

for marker in "<!-- house:roster -->" "<!-- house:read-first -->"; do
  if grep -qxF "$marker" "$HOUSE/AGENTS.md" 2>/dev/null; then ok "marker $marker"; else fail "AGENTS.md lacks marker $marker"; fi
done

for heading in "### The tiers — canonical list" "### The loosenings — canonical list" "#### The two-key rule"; do
  if grep -qxF "$heading" "$HOUSE/AGENTS.md" 2>/dev/null; then ok "section $heading"; else fail "AGENTS.md lacks section: $heading"; fi
done

hook_target="$(git -C "$WORK" rev-parse --git-path hooks/pre-commit 2>/dev/null || true)"
case "$hook_target" in
  "")  fail "work tree is not a git repository: $(display_path "$WORK")" ;;
  /*)  ;;
  *)   hook_target="$WORK/$hook_target" ;;
esac
if [ -n "$hook_target" ]; then
  if [ -x "$hook_target" ]; then ok "pre-commit guard installed in the work tree"; else warn "pre-commit guard not installed → mise run install-hooks"; fi
fi

file_facts() {
  stat -c '%u %a %h' "$1" 2>/dev/null || stat -f '%u %Lp %l' "$1"
}

dir_facts() {
  stat -L -c '%u %a' "$1" 2>/dev/null || stat -L -f '%u %Lp' "$1"
}

private_file() {
  local agent="$1" file="$2" shown uid mode links
  shown="$(display_path "$file")"
  if [ -L "$file" ] || [ ! -f "$file" ]; then fail "$agent: $shown is not a regular file, and secrets refuses a symlink → replace it with the file itself"; return 1; fi
  read -r uid mode links < <(file_facts "$file")
  if [ "$uid" != "$(id -u)" ]; then fail "$agent: $shown is not owned by you → chown $(id -un) $shown"; return 1; fi
  if [ "$links" -ne 1 ]; then fail "$agent: $shown has $links links, and secrets refuses more than one → cp it and rm the original"; return 1; fi
  if (( 8#$mode & 8#077 )); then fail "$agent: $shown is readable by others (mode $mode) → chmod 600 $shown"; return 1; fi
}

credentials() {
  local agent="$1" dir="$2" identity="$2/identity.txt" vault="$2/vault.enc.yaml" uid mode recipient sound=1 tools=1
  read -r uid mode < <(dir_facts "$dir")
  if [ "$uid" != "$(id -u)" ]; then fail "$agent: $(display_path "$dir") is not owned by you → chown $(id -un) $(display_path "$dir")"; sound=0
  elif (( 8#$mode & 8#022 )); then fail "$agent: $(display_path "$dir") is writable by others (mode $mode) → chmod 700 $(display_path "$dir")"; sound=0
  fi
  private_file "$agent" "$identity" || sound=0
  if [ "$(grep -cvE '^(#|$)' "$identity")" -ne 1 ] || ! grep -qxE 'AGE-SECRET-KEY-1[0-9A-Z]{58}' "$identity"; then
    fail "$agent: $(display_path "$identity") must hold exactly one AGE-SECRET-KEY-1… line → the owner mints one with age-keygen -o $(display_path "$identity")"; sound=0
  fi
  recipient="$(awk '/^# public key: / { print $4; exit }' "$identity")"
  [[ "$recipient" =~ ^age1[0-9a-z]{58}$ ]] || { fail "$agent: $(display_path "$identity") has no '# public key: age1…' line, which agent-env reads for the recipient → age-keygen writes one"; sound=0; }
  [ ! -e "$vault" ] || private_file "$agent" "$vault" || sound=0
  if [ "$sound" -eq 1 ] && [ -e "$vault" ] && ! grep -qE "recipient: $recipient$" "$vault"; then
    fail "$agent: $(display_path "$vault") is encrypted to a different recipient than the public-key line of $(display_path "$identity") → age-keygen -y $(display_path "$identity") prints the right one"; sound=0
  fi
  [ "$sound" -eq 1 ] || return 0
  ok "$agent: credentials at $(display_path "$dir") (sops)"
  command -v secrets >/dev/null 2>&1 || { tools=0; warn "$agent: secrets is not on PATH, and agent-env points it at this vault → shiv install secrets"; }
  command -v sops >/dev/null 2>&1 || { tools=0; warn "$agent: sops is not on PATH, and secrets decrypts the vault through it → mise use sops in $(display_path "$HOUSE")"; }
  if [ ! -e "$vault" ]; then
    note "$agent: no vault yet at $(display_path "$vault"); the first secrets set creates it"
  elif [ "$tools" -eq 0 ]; then
    note "$agent: round trip skipped; secrets list needs both tools on PATH"
  elif env SECRETS_PROVIDER=sops SECRETS_SOPS_FILE="$vault" SECRETS_SOPS_AGE_KEY_FILE="$identity" SECRETS_SOPS_RECIPIENT="$recipient" \
         secrets list --prefix "$agent/" >/dev/null 2>&1; then
    ok "$agent: secrets opens the vault with this identity"
  else
    fail "$agent: secrets cannot open the vault with this identity → eval \"\$(mise run -q agent-env $agent)\" in the house, then secrets list --prefix $agent/ says why"
  fi
}

count=0
keepers=0
homes=()
while IFS= read -r agent; do
  count=$((count + 1))
  kind="$(roster_kind "$HOUSE" "$agent")"
  home="$(agent_workspace "$HOUSE" "$agent" "$kind")/home"
  if [ "$kind" = housekeeper ]; then
    keepers=$((keepers + 1))
    [ "$agent" = "$HOUSEKEEPER" ] || fail "$agent: a housekeeper must be named $HOUSEKEEPER"
  fi
  if [ -f "$HOUSE/notes/$agent.md" ]; then ok "$agent: notes/$agent.md"; else fail "$agent: notes/$agent.md missing"; fi
  if grep -q "^- \*\*$agent\*\* — " "$HOUSE/AGENTS.md"; then ok "$agent: on the roster in AGENTS.md"; else fail "$agent: not listed under 'Who lives here' in AGENTS.md"; fi
  if [ -f "$home/AGENTS.md" ]; then ok "$agent: home at $(display_path "$home")"; homes+=("$home"); else warn "$agent: no home at $(display_path "$home")"; fi
  secrets_dir="$(agent_secrets_dir "$HOUSE" "$agent" "$kind")"
  if [ -f "$secrets_dir/identity.txt" ]; then
    if [ "$kind" = housekeeper ]; then
      fail "$agent: has $(display_path "$secrets_dir")/identity.txt; a housekeeper has no account, ever → move or delete it"
    else
      credentials "$agent" "$secrets_dir"
    fi
  fi
done < <(roster_agents "$HOUSE")
[ "$count" -gt 0 ] || warn "roster is empty → house agent add <name> --role <role>"
[ "$keepers" -le 1 ] || fail "roster lists $keepers housekeepers; a house has exactly one"
[ "$keepers" -eq 1 ] || warn "no housekeeper → house agent add $HOUSEKEEPER"

say ""
leftovers=0
hits() {
  grep -rn "$@" --exclude-dir=.git -- "$HOUSE" "${homes[@]}" 2>/dev/null || true
}
report() {
  local kind="$1" line file rest
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    file="${line%%:*}"
    rest="${line#*:}"
    case "$file" in "$HOUSE"/*) file="${file#"$HOUSE"/}" ;; *) file="$(display_path "$file")" ;; esac
    fail "$kind: $file:$rest"
    leftovers=$((leftovers + 1))
  done
}
report placeholder < <(hits -oE '\{\{[A-Z_]+\}\}')
lineage="$(lineage_names "$HOUSE" | paste -sd '|')"
report lineage < <(hits -iwE "$lineage")
report lineage < <(hits -iwE 'KnickKnackLabs|Knick Knack Labs' --exclude=mise.toml)
if [ "$leftovers" -eq 0 ]; then
  ok "nothing here is the framework's: no {{placeholder}}, no lineage name"
fi

say ""
if [ "$FAILS" -eq 0 ]; then
  say "doctor: healthy"
else
  say "doctor: $FAILS failing"
  [ "$leftovers" -eq 0 ] || say "next: each placeholder: and lineage: line is the owner's to fix in the text around it"
  exit 1
fi

#!/usr/bin/env bash
#MISE description="Orientation and setup health for the {{HOUSE_NAME}} household"
set -eo pipefail

roster="$HOUSE_DIR/roster.tsv"

on_roster() {
  awk -F '\t' -v n="$1" '!/^#/ && $1 == n { found = 1 } END { exit !found }' "$roster"
}

credentials() {
  local dir="${HOUSE_AGENTS_ROOT:-$HOME/agents}/$1/.secrets"
  if [ -f "$dir/identity.txt" ]; then
    echo "credentials: sops vault at ${dir/#"$HOME"/\~}"
  else
    echo "credentials: none"
  fi
}

echo "== identity =="
author="${GIT_AUTHOR_NAME:-unset}"
echo "GIT_AUTHOR_NAME: $author"
if [ "$author" = unset ]; then
  echo "not activated — ask the owner which agent you are, then: eval \"\$(mise run -q agent-env <name>)\""
elif [ "$author" = housekeeper ]; then
  echo "home: ~/agents/$HOUSE_NAME/home/AGENTS.md (the house's own; you are its voice)"
  credentials "$HOUSE_NAME"
elif on_roster "$author"; then
  echo "home: ~/agents/$author/home/AGENTS.md"
  credentials "$author"
else
  echo "not a household agent; owner commits need {{HOUSE_UPPER}}_OWNER_COMMIT=1"
fi

echo ""
echo "== roster =="
agents="$(awk -F '\t' '!/^#/ && NF { print $1 }' "$roster" | tr '\n' ' ')"
if [ -n "$agents" ]; then
  echo "$agents"
else
  echo "nobody yet → house agent add <name> --house $HOUSE_DIR --role <role>"
fi

echo ""
echo "== work tree =="
work="$(cd "$WORK_DIR" && pwd -P)"
echo "path: $work"
echo "branch: $(git -C "$WORK_DIR" branch --show-current 2>/dev/null || echo '?')"
dirty=$(git -C "$WORK_DIR" status --porcelain 2>/dev/null | wc -l)
echo "uncommitted paths: $dirty"
hook="$(git -C "$WORK_DIR" rev-parse --git-path hooks/pre-commit 2>/dev/null || true)"
case "$hook" in /*) ;; ?*) hook="$WORK_DIR/$hook" ;; esac
if [ -n "$hook" ] && [ -x "$hook" ]; then
  echo "pre-commit guard: installed"
else
  echo "pre-commit guard: missing → mise run install-hooks"
fi

echo ""
echo "== signing =="
if [ "$(git -C "$WORK_DIR" config --type=bool commit.gpgsign 2>/dev/null)" = true ]; then
  format="$(git -C "$WORK_DIR" config gpg.format 2>/dev/null || echo openpgp)"
  key="$(git -C "$WORK_DIR" config user.signingkey 2>/dev/null || echo "unset; picked by the committer identity")"
  echo "commits here: signed ($format, key $key)"
  echo "agent-env sets the author only: a commit made as an agent is signed with this same key and verifies as its holder, not as the agent"
  echo "a passphrase prompt during a commit is for this key; if it stalls, stop and report — never turn signing off"
else
  echo "commits here: unsigned"
fi

echo ""
echo "== work queue =="
queue="$HOUSE_DIR/notes/work-queue.md"
if grep -q '^- state: queued$' "$queue"; then
  grep -B1 '^- state: queued$' "$queue" | grep '^## ' | head -3
else
  echo "nothing queued"
fi

echo ""
echo "== read first =="
echo "$HOUSE_DIR/AGENTS.md"
